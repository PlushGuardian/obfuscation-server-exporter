// SetGroupedUsage replaces the default help printer with one that
// shows the original flag names (saved in annotations) grouped by
// the normalised name's top‑level prefix (before the first dot).
func SetGroupedUsage(fs *pflag.FlagSet) {
	fmt.Println("test")
	fs.Usage = func() {
		type group struct {
			name  string
			flags []*pflag.Flag
		}

		groups := make(map[string]*group)
		var groupOrder []string
		fmt.Println("test2")
		fs.VisitAll(func(flag *pflag.Flag) {
			// Determine group from the normalised name
			groupKey := "General"
			if idx := strings.IndexByte(flag.Name, '.'); idx != -1 {
				groupKey = flag.Name[:idx]
			}
			grp, exists := groups[groupKey]
			if !exists {
				grp = &group{name: groupKey}
				groups[groupKey] = grp
				groupOrder = append(groupOrder, groupKey)
			}
			grp.flags = append(grp.flags, flag)
		})

		out := fs.Output()
		fmt.Fprintf(out, "Usage of %s:\n", fs.Name())

		for _, key := range groupOrder {
			grp := groups[key]
			if grp.name == "General" {
				fmt.Fprintf(out, "\nGeneral settings:\n")
			} else {
				fmt.Fprintf(out, "\n%s settings:\n", grp.name)
			}
			for _, flag := range grp.flags {
				// Use the original name stored by NormalizeFlags
				name := flag.Name
				if ann, ok := flag.Annotations["original-name"]; ok && len(ann) > 0 {
					name = ann[0]
				}
				usage := flag.Usage
				if flag.DefValue != "" && flag.DefValue != "false" && flag.DefValue != "0" {
					usage += fmt.Sprintf(" (default %v)", flag.DefValue)
				}
				fmt.Fprintf(out, "  --%s\n      %s\n", name, usage)
			}
		}
	}
}
