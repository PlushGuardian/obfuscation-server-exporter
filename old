// ---------------------------------------------------------------
//  2. A small helper for the template: groups flags by prefix,
//     and uses the original name from the annotation.
//
// ---------------------------------------------------------------
type flagGroup struct {
	Name  string
	Flags []*pflag.Flag
}

func groupFlags(flags *pflag.FlagSet) []flagGroup {
	groupMap := make(map[string]*flagGroup)
	var order []string

	flags.VisitAll(func(f *pflag.Flag) {
		key := "General"
		if idx := strings.IndexByte(f.Name, '.'); idx != -1 {
			key = f.Name[:idx]
		}
		if grp, ok := groupMap[key]; ok {
			grp.Flags = append(grp.Flags, f)
		} else {
			groupMap[key] = &flagGroup{Name: key, Flags: []*pflag.Flag{f}}
			order = append(order, key)
		}
	})
	result := make([]flagGroup, len(order))
	for i, k := range order {
		result[i] = *groupMap[k]
	}
	return result
}

// getFlagName returns the original name if saved, else the current name.
func getFlagName(f *pflag.Flag) string {
	if ann, ok := f.Annotations["original-name"]; ok && len(ann) > 0 {
		return ann[0]
	}
	return f.Name
}

